# ClickUp personal API token for this app's own integration (do not reuse another app's token)
CLICKUP_API_TOKEN=

# Postgres connection string (Vercel Postgres, Neon, Supabase, or local)
POSTGRES_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` to /api/cron/sync
CRON_SECRET=
